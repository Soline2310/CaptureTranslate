{
  "languages": {
    "source": "ja",
    "target": "en"
  },
  "hotkey": "ctrl+shift+t",
  "capture": {
    "dpi_aware": true,
    "overlay_opacity": 0.3,
    "min_region_size": 10
  },
  "preprocess": {
    "enabled": true,
    "upscale_factor": 2,
    "grayscale": true
  },
  "ocr": {
    "engine": "windows",
    "engines": {
      "windows": {
        "language_tag": "ja"
      },
      "paddle": {
        "lang": "japan",
        "use_gpu": false
      }
    }
  },
  "translate": {
    "engine": "argos",
    "engines": {
      "argos": {
        "from_code": "ja",
        "to_code": "en"
      },
      "ollama": {
        "host": "http://localhost:11434",
        "model": "qwen2.5:7b",
        "timeout_seconds": 60
      }
    }
  },
  "ui": {
    "popup_font_family": "Segoe UI",
    "popup_font_size": 12,
    "popup_max_width": 480,
    "popup_auto_close_seconds": 0,
    "show_original_text": true,
    "copy_translation_button": true
  },
  "debug": {
    "save_snips": false,
    "snips_folder": "tests/sample_images",
    "log_level": "INFO"
  }
}
